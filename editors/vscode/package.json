{
  "name": "ironshell",
  "displayName": "IronShell",
  "description": "Language support for IronShell - a typed, functional shell with AI capabilities",
  "version": "1.6.1",
  "publisher": "admercs",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters",
    "Snippets",
    "Machine Learning"
  ],
  "keywords": [
    "shell",
    "ironshell",
    "functional",
    "ai",
    "typed",
    "agents",
    "llm",
    "cursor",
    "open-vsx"
  ],
  "activationEvents": [
    "onLanguage:ironshell"
  ],
  "main": "./out/extension.js",
  "capabilities": {
    "documentSymbolProvider": "true",
    "foldingRangeProvider": "true",
    "hoverProvider": "true",
    "codeActionProvider": "true"
  },
  "contributes": {
    "languages": [
      {
        "id": "ironshell",
        "aliases": [
          "IronShell",
          "ironshell",
          "ish"
        ],
        "extensions": [
          ".ish"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/ae-icon.svg",
          "dark": "./icons/ae-icon.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "ironshell",
        "scopeName": "source.ironshell",
        "path": "./syntaxes/ironshell.tmLanguage.json"
      },
      {
        "scopeName": "markdown.ironshell.codeblock",
        "path": "./syntaxes/ironshell.markdown.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.ironshell": "ironshell"
        }
      }
    ],
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "ironshell.agentPanel",
          "name": "AI Agents",
          "when": "resourceLangId == ironshell || resourceExtname == .ish"
        }
      ]
    },
    "configuration": {
      "title": "IronShell",
      "properties": {
        "ironshell.lsp.path": {
          "type": "string",
          "default": "",
          "description": "Path to the IronShell language server binary."
        },
        "ironshell.lsp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable the IronShell language server."
        },
        "ironshell.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the language server."
        },
        "ironshell.executable.path": {
          "type": "string",
          "default": "",
          "description": "Path to the IronShell executable (ish). If empty, uses 'ish' from PATH."
        },
        "ironshell.ai.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable AI-powered features like code improvements."
        },
        "ironshell.ai.provider": {
          "type": "string",
          "enum": [
            "openai",
            "anthropic",
            "ollama",
            "auto"
          ],
          "default": "auto",
          "description": "AI provider to use for AI-powered features."
        },
        "ironshell.runOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Automatically run the file when saved."
        }
      }
    },
    "commands": [
      {
        "command": "ironshell.restartServer",
        "title": "Restart Language Server",
        "category": "IronShell"
      },
      {
        "command": "ironshell.showOutput",
        "title": "Show Output Channel",
        "category": "IronShell"
      },
      {
        "command": "ironshell.runFile",
        "title": "Run File",
        "category": "IronShell",
        "icon": "$(play)"
      },
      {
        "command": "ironshell.runSelection",
        "title": "Run Selection/Line",
        "category": "IronShell",
        "icon": "$(debug-start)"
      },
      {
        "command": "ironshell.startRepl",
        "title": "Start REPL",
        "category": "IronShell",
        "icon": "$(terminal)"
      },
      {
        "command": "ironshell.startTui",
        "title": "Start TUI Mode",
        "category": "IronShell",
        "icon": "$(screen-full)"
      },
      {
        "command": "ironshell.extractFunction",
        "title": "Extract to Function",
        "category": "IronShell"
      },
      {
        "command": "ironshell.wrapWithTryCatch",
        "title": "Wrap with try-catch",
        "category": "IronShell"
      },
      {
        "command": "ironshell.aiImprove",
        "title": "AI: Improve Code",
        "category": "IronShell",
        "icon": "$(sparkle)"
      },
      {
        "command": "ironshell.aiDocument",
        "title": "AI: Generate Documentation",
        "category": "IronShell",
        "icon": "$(book)"
      },
      {
        "command": "ironshell.convertToPipeline",
        "title": "Convert to Pipeline",
        "category": "IronShell"
      },
      {
        "command": "ironshell.addTypeAnnotation",
        "title": "Add Type Annotation",
        "category": "IronShell"
      },
      {
        "command": "ironshell.convertToFormat",
        "title": "Convert to format()",
        "category": "IronShell"
      }
    ],
    "keybindings": [
      {
        "command": "ironshell.runFile",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "editorLangId == ironshell"
      },
      {
        "command": "ironshell.runSelection",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorLangId == ironshell"
      },
      {
        "command": "ironshell.startRepl",
        "key": "ctrl+shift+t",
        "mac": "cmd+shift+t",
        "when": "editorLangId == ironshell"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "ironshell.runFile",
          "when": "resourceLangId == ironshell",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "ironshell.runSelection",
          "when": "editorLangId == ironshell",
          "group": "1_run"
        },
        {
          "command": "ironshell.aiImprove",
          "when": "editorLangId == ironshell && editorHasSelection",
          "group": "2_ai"
        }
      ]
    },
    "snippets": [
      {
        "language": "ironshell",
        "path": "./snippets/ironshell.json"
      }
    ],
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "./styles/ironshell-preview.css"
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "lint": "eslint src --ext ts",
    "package": "vsce package",
    "test": "node --test test/grammar.test.mjs test/language-configuration.test.mjs test/manifest.test.mjs test/snippets.test.mjs test/providers.test.mjs test/runner.test.mjs test/codeactions-markdown.test.mjs test/package.test.mjs test/cursor.test.mjs",
    "publish:vscode": "vsce publish",
    "publish:openvsx": "ovsx publish",
    "publish:all": "npm run publish:vscode && npm run publish:openvsx"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vscode/vsce": "^2.22.0",
    "eslint": "^8.55.0",
    "ovsx": "^1.1.1",
    "typescript": "^5.3.2",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nervosys/AetherShell"
  },
  "bugs": {
    "url": "https://github.com/nervosys/AetherShell/issues"
  },
  "homepage": "https://github.com/nervosys/AetherShell#readme"
}
