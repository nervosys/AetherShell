{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "AetherShell Markdown Code Blocks",
    "scopeName": "markdown.aethershell.codeblock",
    "injectionSelector": "L:text.html.markdown",
    "patterns": [
        {
            "include": "#aethershell-fenced-code-block"
        }
    ],
    "repository": {
        "aethershell-fenced-code-block": {
            "begin": "(^|\\G)(\\s*)(`{3,})\\s*(?i:(ae|aether|aethershell))\\s*$",
            "end": "(^|\\G)(\\2)(\\3)\\s*$",
            "beginCaptures": {
                "3": {
                    "name": "punctuation.definition.markdown"
                },
                "4": {
                    "name": "fenced_code.block.language.markdown"
                }
            },
            "endCaptures": {
                "3": {
                    "name": "punctuation.definition.markdown"
                }
            },
            "name": "markup.fenced_code.block.markdown",
            "contentName": "meta.embedded.block.aethershell",
            "patterns": [
                {
                    "include": "source.aethershell"
                }
            ]
        }
    }
}