{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "IronShell",
  "scopeName": "source.ironshell",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#function-calls"
    },
    {
      "include": "#member-access"
    },
    {
      "include": "#lambdas"
    },
    {
      "include": "#records"
    },
    {
      "include": "#variables"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.ironshell",
          "match": "#.*$"
        },
        {
          "name": "comment.line.double-slash.ironshell",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.ironshell",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.ironshell",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.ironshell",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.ironshell",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.interpolated.ironshell",
          "begin": "`",
          "end": "`",
          "patterns": [
            {
              "name": "constant.character.escape.ironshell",
              "match": "\\\\."
            },
            {
              "name": "variable.other.interpolated.ironshell",
              "match": "\\$\\{[^}]+\\}"
            },
            {
              "name": "variable.other.interpolated.ironshell",
              "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.ironshell",
          "match": "\\b\\d+\\.\\d+([eE][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.integer.hexadecimal.ironshell",
          "match": "\\b0x[0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.integer.octal.ironshell",
          "match": "\\b0o[0-7]+\\b"
        },
        {
          "name": "constant.numeric.integer.binary.ironshell",
          "match": "\\b0b[01]+\\b"
        },
        {
          "name": "constant.numeric.integer.ironshell",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.ironshell",
          "match": "\\b(if|else|match)\\b"
        },
        {
          "name": "keyword.control.exception.ironshell",
          "match": "\\b(try|catch|throw)\\b"
        },
        {
          "name": "keyword.control.async.ironshell",
          "match": "\\b(async|await)\\b"
        },
        {
          "name": "keyword.control.import.ironshell",
          "match": "\\b(import|export|from|as)\\b"
        },
        {
          "name": "storage.modifier.ironshell",
          "match": "\\b(let|mut|pub)\\b"
        },
        {
          "name": "keyword.other.fn.ironshell",
          "match": "\\b(fn)\\b"
        },
        {
          "name": "constant.language.boolean.ironshell",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.ironshell",
          "match": "\\b(null)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.pipe.ironshell",
          "match": "\\|(?!\\|)"
        },
        {
          "name": "keyword.operator.arrow.ironshell",
          "match": "=>"
        },
        {
          "name": "keyword.operator.assignment.ironshell",
          "match": "="
        },
        {
          "name": "keyword.operator.comparison.ironshell",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.ironshell",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.arithmetic.ironshell",
          "match": "\\+|-|\\*|/|%"
        },
        {
          "name": "keyword.operator.spread.ironshell",
          "match": "\\.\\.\\."
        },
        {
          "name": "keyword.operator.accessor.ironshell",
          "match": "\\."
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.io.ironshell",
          "match": "\\b(print|echo|cat|head|tail|grep|ls|pwd|cd|mkdir|rm|cp|mv|touch|chmod)\\b"
        },
        {
          "name": "support.function.builtin.pipeline.ironshell",
          "match": "\\b(map|where|reduce|take|first|last|len|sort|uniq|flatten|reverse|foreach|any|all|zip)\\b"
        },
        {
          "name": "support.function.builtin.string.ironshell",
          "match": "\\b(split|join|trim|upper|lower|replace|contains|starts_with|ends_with)\\b"
        },
        {
          "name": "support.function.builtin.data.ironshell",
          "match": "\\b(keys|values|type_of|to_json)\\b"
        },
        {
          "name": "support.function.builtin.math.ironshell",
          "match": "\\b(abs|min|max|sum|avg|round|floor|ceil|sqrt|pow)\\b"
        },
        {
          "name": "support.function.builtin.network.ironshell",
          "match": "\\b(http_get|fetch)\\b"
        },
        {
          "name": "support.function.builtin.ai.ironshell",
          "match": "\\b(ai|agent|swarm|mcp_call)\\b"
        },
        {
          "name": "support.function.builtin.system.ironshell",
          "match": "\\b(env|exit|sleep|range|help|clear)\\b"
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "comment": "Function call: identifier followed by (",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.ironshell"
            },
            "2": {
              "name": "punctuation.bracket.round.ironshell"
            }
          }
        }
      ]
    },
    "member-access": {
      "patterns": [
        {
          "comment": "Method call: .identifier(",
          "match": "(\\.)([a-zA-Z_][a-zA-Z0-9_]*)\\s*(\\()",
          "captures": {
            "1": {
              "name": "keyword.operator.accessor.ironshell"
            },
            "2": {
              "name": "entity.name.function.member.ironshell"
            },
            "3": {
              "name": "punctuation.bracket.round.ironshell"
            }
          }
        },
        {
          "comment": "Property access: .identifier (not followed by paren)",
          "match": "(\\.)([a-zA-Z_][a-zA-Z0-9_]*)(?!\\s*\\()",
          "captures": {
            "1": {
              "name": "keyword.operator.accessor.ironshell"
            },
            "2": {
              "name": "variable.other.property.ironshell"
            }
          }
        }
      ]
    },
    "lambdas": {
      "patterns": [
        {
          "name": "meta.function.lambda.ironshell",
          "begin": "\\b(fn)\\s*\\(",
          "beginCaptures": {
            "1": {
              "name": "keyword.other.fn.ironshell"
            }
          },
          "end": "\\)",
          "patterns": [
            {
              "name": "variable.parameter.ironshell",
              "match": "[a-zA-Z_][a-zA-Z0-9_]*"
            },
            {
              "name": "punctuation.separator.parameter.ironshell",
              "match": ","
            }
          ]
        }
      ]
    },
    "records": {
      "patterns": [
        {
          "name": "meta.record.ironshell",
          "begin": "\\{",
          "end": "\\}",
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "include": "#strings"
            },
            {
              "name": "variable.other.property.ironshell",
              "match": "([a-zA-Z_][a-zA-Z0-9_]*)\\s*:"
            },
            {
              "include": "$self"
            }
          ]
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.ironshell",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.bracket.round.ironshell",
          "match": "[()]"
        },
        {
          "name": "punctuation.bracket.square.ironshell",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.bracket.curly.ironshell",
          "match": "[{}]"
        },
        {
          "name": "punctuation.separator.comma.ironshell",
          "match": ","
        },
        {
          "name": "punctuation.separator.colon.ironshell",
          "match": ":"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "comment": "Function definition: let name = fn(...)",
          "match": "\\b(let)\\s+(mut\\s+)?([a-zA-Z_][a-zA-Z0-9_]*)\\s*(=)\\s*(fn)\\b",
          "captures": {
            "1": {
              "name": "storage.modifier.ironshell"
            },
            "2": {
              "name": "storage.modifier.mutable.ironshell"
            },
            "3": {
              "name": "entity.name.function.definition.ironshell"
            },
            "4": {
              "name": "keyword.operator.assignment.ironshell"
            },
            "5": {
              "name": "keyword.other.fn.ironshell"
            }
          }
        },
        {
          "comment": "Variable declaration",
          "name": "meta.declaration.variable.ironshell",
          "match": "\\b(let)\\s+(mut\\s+)?([a-zA-Z_][a-zA-Z0-9_]*)\\s*(=)",
          "captures": {
            "1": {
              "name": "storage.modifier.ironshell"
            },
            "2": {
              "name": "storage.modifier.mutable.ironshell"
            },
            "3": {
              "name": "variable.other.declaration.ironshell"
            },
            "4": {
              "name": "keyword.operator.assignment.ironshell"
            }
          }
        }
      ]
    }
  }
}
