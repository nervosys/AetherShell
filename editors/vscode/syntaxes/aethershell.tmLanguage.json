{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "AetherShell",
    "scopeName": "source.aethershell",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#operators"
        },
        {
            "include": "#builtins"
        },
        {
            "include": "#lambdas"
        },
        {
            "include": "#records"
        },
        {
            "include": "#variables"
        },
        {
            "include": "#punctuation"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.number-sign.aethershell",
                    "match": "#.*$"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.aethershell",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.aethershell",
                            "match": "\\\\."
                        }
                    ]
                },
                {
                    "name": "string.quoted.single.aethershell",
                    "begin": "'",
                    "end": "'",
                    "patterns": [
                        {
                            "name": "constant.character.escape.aethershell",
                            "match": "\\\\."
                        }
                    ]
                },
                {
                    "name": "string.interpolated.aethershell",
                    "begin": "`",
                    "end": "`",
                    "patterns": [
                        {
                            "name": "constant.character.escape.aethershell",
                            "match": "\\\\."
                        },
                        {
                            "name": "variable.other.interpolated.aethershell",
                            "match": "\\$\\{[^}]+\\}"
                        },
                        {
                            "name": "variable.other.interpolated.aethershell",
                            "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*"
                        }
                    ]
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.float.aethershell",
                    "match": "\\b\\d+\\.\\d+([eE][+-]?\\d+)?\\b"
                },
                {
                    "name": "constant.numeric.integer.hexadecimal.aethershell",
                    "match": "\\b0x[0-9a-fA-F]+\\b"
                },
                {
                    "name": "constant.numeric.integer.octal.aethershell",
                    "match": "\\b0o[0-7]+\\b"
                },
                {
                    "name": "constant.numeric.integer.binary.aethershell",
                    "match": "\\b0b[01]+\\b"
                },
                {
                    "name": "constant.numeric.integer.aethershell",
                    "match": "\\b\\d+\\b"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.aethershell",
                    "match": "\\b(let|mut|match|if)\\b"
                },
                {
                    "name": "keyword.other.fn.aethershell",
                    "match": "\\b(fn)\\b"
                },
                {
                    "name": "constant.language.boolean.aethershell",
                    "match": "\\b(true|false)\\b"
                },
                {
                    "name": "constant.language.null.aethershell",
                    "match": "\\b(null)\\b"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.pipe.aethershell",
                    "match": "\\|(?!\\|)"
                },
                {
                    "name": "keyword.operator.arrow.aethershell",
                    "match": "=>"
                },
                {
                    "name": "keyword.operator.assignment.aethershell",
                    "match": "="
                },
                {
                    "name": "keyword.operator.comparison.aethershell",
                    "match": "==|!=|<=|>=|<|>"
                },
                {
                    "name": "keyword.operator.logical.aethershell",
                    "match": "&&|\\|\\||!"
                },
                {
                    "name": "keyword.operator.arithmetic.aethershell",
                    "match": "\\+|-|\\*|/|%"
                },
                {
                    "name": "keyword.operator.spread.aethershell",
                    "match": "\\.\\.\\."
                },
                {
                    "name": "keyword.operator.accessor.aethershell",
                    "match": "\\."
                }
            ]
        },
        "builtins": {
            "patterns": [
                {
                    "name": "support.function.builtin.io.aethershell",
                    "match": "\\b(print|echo|cat|head|tail|grep|ls|pwd|cd|mkdir|rm|cp|mv|touch|chmod)\\b"
                },
                {
                    "name": "support.function.builtin.pipeline.aethershell",
                    "match": "\\b(map|where|reduce|take|first|last|len|sort|uniq|flatten|reverse|foreach|any|all|zip|enumerate)\\b"
                },
                {
                    "name": "support.function.builtin.string.aethershell",
                    "match": "\\b(split|join|trim|upper|lower|replace|contains|starts_with|ends_with|substring)\\b"
                },
                {
                    "name": "support.function.builtin.data.aethershell",
                    "match": "\\b(keys|values|entries|merge|get|set|type_of|to_string|to_int|to_float|parse_json|to_json)\\b"
                },
                {
                    "name": "support.function.builtin.math.aethershell",
                    "match": "\\b(abs|min|max|sum|avg|round|floor|ceil|sqrt|pow|log|sin|cos|tan)\\b"
                },
                {
                    "name": "support.function.builtin.network.aethershell",
                    "match": "\\b(http_get|http_post|http_put|http_delete|fetch|download)\\b"
                },
                {
                    "name": "support.function.builtin.ai.aethershell",
                    "match": "\\b(ai|agent|swarm|mcp_call|mcp_list)\\b"
                },
                {
                    "name": "support.function.builtin.system.aethershell",
                    "match": "\\b(env|exec|spawn|exit|sleep|range|help|clear)\\b"
                }
            ]
        },
        "lambdas": {
            "patterns": [
                {
                    "name": "meta.function.lambda.aethershell",
                    "begin": "\\b(fn)\\s*\\(",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.other.fn.aethershell"
                        }
                    },
                    "end": "\\)",
                    "patterns": [
                        {
                            "name": "variable.parameter.aethershell",
                            "match": "[a-zA-Z_][a-zA-Z0-9_]*"
                        },
                        {
                            "name": "punctuation.separator.parameter.aethershell",
                            "match": ","
                        }
                    ]
                }
            ]
        },
        "records": {
            "patterns": [
                {
                    "name": "meta.record.aethershell",
                    "begin": "\\{",
                    "end": "\\}",
                    "patterns": [
                        {
                            "include": "#comments"
                        },
                        {
                            "include": "#strings"
                        },
                        {
                            "include": "#numbers"
                        },
                        {
                            "include": "#keywords"
                        },
                        {
                            "name": "variable.other.property.aethershell",
                            "match": "([a-zA-Z_][a-zA-Z0-9_]*)\\s*:"
                        },
                        {
                            "include": "#records"
                        }
                    ]
                }
            ]
        },
        "variables": {
            "patterns": [
                {
                    "name": "meta.declaration.variable.aethershell",
                    "match": "\\b(let)\\s+(mut\\s+)?([a-zA-Z_][a-zA-Z0-9_]*)\\s*=",
                    "captures": {
                        "1": {
                            "name": "keyword.control.aethershell"
                        },
                        "2": {
                            "name": "storage.modifier.mutable.aethershell"
                        },
                        "3": {
                            "name": "variable.other.declaration.aethershell"
                        }
                    }
                },
                {
                    "name": "variable.other.aethershell",
                    "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
                }
            ]
        },
        "punctuation": {
            "patterns": [
                {
                    "name": "punctuation.bracket.round.aethershell",
                    "match": "[()]"
                },
                {
                    "name": "punctuation.bracket.square.aethershell",
                    "match": "[\\[\\]]"
                },
                {
                    "name": "punctuation.bracket.curly.aethershell",
                    "match": "[{}]"
                },
                {
                    "name": "punctuation.separator.comma.aethershell",
                    "match": ","
                },
                {
                    "name": "punctuation.separator.colon.aethershell",
                    "match": ":"
                }
            ]
        }
    }
}