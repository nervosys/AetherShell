// Complex Workflow Tests for AetherShell
// Testing operation chaining, lambda compositions, and advanced patterns

print("=== Complex Workflow Tests ===")
print("")

// Test 1: Multi-stage pipeline with lambdas
print("Test 1: Multi-stage data transformation pipeline")
result1 = range(1, 21) 
  | where(fn(x) => x % 2 == 0)
  | map(fn(x) => x * x)
  | where(fn(x) => x > 50)
  | take(3)
print(result1)
print("")

// Test 2: String processing chain
print("Test 2: Complex string processing")
result2 = "hello,world,foo,bar,baz"
  | split(",")
  | map(fn(s) => upper(s))
  | where(fn(s) => contains(s, "A"))
  | join(" -> ")
print(result2)
print("")

// Test 3: Nested lambda with reduce
print("Test 3: Factorial using reduce with lambda")
factorial = fn(n) => range(1, n + 1) | reduce(fn(a, b) => a * b, 1)
result3 = factorial(6)
print("6! = " + result3)
print("")

// Test 4: Array transformation with flatten and reverse
print("Test 4: Nested array operations")
nested = [[1, 2], [3, 4], [5, 6]]
result4 = nested 
  | map(fn(arr) => arr | map(fn(x) => x * 2))
  | flatten()
  | reverse()
  | slice(0, 4)
print(result4)
print("")

// Test 5: Lambda composition pattern
print("Test 5: Function composition")
double = fn(x) => x * 2
square = fn(x) => x * x
add_ten = fn(x) => x + 10

result5 = [1, 2, 3, 4, 5]
  | map(double)
  | map(square)
  | map(add_ten)
  | reduce(fn(a, b) => a + b, 0)
print("Sum after double->square->add10: " + result5)
print("")

// Test 6: Conditional filtering with multiple predicates
print("Test 6: Complex filtering")
numbers = range(1, 101)
result6 = numbers
  | where(fn(x) => x % 3 == 0)
  | where(fn(x) => x % 5 == 0)
  | take(5)
print(result6)
print("")

// Test 7: String manipulation chain
print("Test 7: Advanced string manipulation")
sentence = "  The Quick Brown Fox Jumps  "
result7 = sentence
  | trim()
  | lower()
  | split(" ")
  | map(fn(word) => upper(word))
  | where(fn(word) => len(word) > 3)
  | reverse()
  | join("-")
print(result7)
print("")

// Test 8: Zip and transform
print("Test 8: Zip with transformation")
names = ["Alice", "Bob", "Charlie"]
scores = [95, 87, 92]
result8 = zip(names, scores)
  | map(fn(pair) => first(pair) + ": " + last(pair))
  | join(", ")
print(result8)
print("")

// Test 9: Range-based math operations
print("Test 9: Sum of squares of even numbers 1-20")
result9 = range(1, 21)
  | where(fn(x) => x % 2 == 0)
  | map(fn(x) => pow(x, 2))
  | reduce(fn(a, b) => a + b, 0)
print("Sum: " + result9)
print("")

// Test 10: Deep nesting with multiple operations
print("Test 10: Complex nested operations")
result10 = range(1, 11)
  | map(fn(x) => range(1, x + 1))
  | map(fn(arr) => arr | reduce(fn(a, b) => a + b, 0))
  | where(fn(sum) => sum % 2 == 0)
  | map(fn(x) => x / 2)
print(result10)
print("")

// Test 11: Lambda composition pattern
print("Test 11: Lambda composition pattern")
times3 = fn(x) => x * 3
times5 = fn(x) => x * 5

result11a = [1, 2, 3, 4] | map(times3)
result11b = [1, 2, 3, 4] | map(times5)
print(result11a)
print(result11b)
print("")

// Test 12: All/Any with complex predicates
print("Test 12: All/Any predicates")
numbers12 = [2, 4, 6, 8, 10]
all_even = numbers12 | all(fn(x) => x % 2 == 0)
any_gt_5 = numbers12 | any(fn(x) => x > 5)
print(all_even)
print(any_gt_5)
print("")

// Test 13: String array with complex transformation
print("Test 13: String array pipeline")
words = ["apple", "banana", "cherry", "date", "elderberry"]
result13 = words
  | where(fn(w) => len(w) > 5)
  | map(fn(w) => upper(w))
  | map(fn(w) => split(w, ""))
  | map(fn(arr) => reverse(arr))
  | map(fn(arr) => join(arr, ""))
  | join(", ")
print(result13)
print("")

// Test 14: Mathematical series calculation
print("Test 14: Max of polynomial series")
result14 = range(1, 11)
  | map(fn(n) => pow(n, 2) + n)
  | reduce(fn(a, b) => max(a, b), 0)
print("Max of (n^2 + n) series: " + result14)
print("")

// Test 15: Multi-level filtering and mapping
print("Test 15: Complex divisibility filtering")
result15 = range(2, 30)
  | where(fn(x) => !(x % 2 == 0 && x % 3 == 0))
  | take(8)
  | map(fn(x) => x * x)
print(result15)
print("")

// Test 16: Concat and flatten operations
print("Test 16: Array concatenation and flattening")
arr1 = [1, 2, 3]
arr2 = [4, 5, 6]
arr3 = [7, 8, 9]
result16 = [arr1, arr2, arr3]
  | flatten()
  | map(fn(x) => [x, x * 2])
  | flatten()
  | where(fn(x) => x % 3 != 0)
  | take(10)
print(result16)
print("")

// Test 17: Slice with reverse and map
print("Test 17: Slice operations with transformations")
alphabet = "abcdefghijklmnopqrstuvwxyz"
result17 = alphabet
  | split("")
  | slice(5, 15)
  | map(fn(c) => upper(c))
  | reverse()
  | join("")
print(result17)
print("")

// Test 18: Chained reduce operations
print("Test 18: Product and sum comparison")
nums = [2, 3, 4, 5]
product = nums | reduce(fn(a, b) => a * b, 1)
sum = nums | reduce(fn(a, b) => a + b, 0)
print("Product: " + product + ", Sum: " + sum)
print("")

// Test 19: Nested map operations
print("Test 19: Double map transformation")
result19 = range(1, 6)
  | map(fn(x) => x * 2)
  | map(fn(x) => x + 10)
  | map(fn(x) => x / 2)
  | map(fn(x) => pow(x, 2))
print(result19)
print("")

// Test 20: Comprehensive pipeline
print("Test 20: Master pipeline")
result20 = range(1, 51)
  | where(fn(x) => x % 7 == 0)
  | map(fn(x) => pow(x, 2))
  | where(fn(x) => x > 100)
  | take(3)
  | map(fn(x) => "Square: " + x)
  | join(", ")
print(result20)
print("")

print("=== All Complex Workflow Tests Complete ===")
