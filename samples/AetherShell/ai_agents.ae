# AetherShell — AI Integration & Autonomous Agents
# Native multi-modal AI with model URIs and agent framework

# Simple AI prompt
response = ai("Explain the concept of recursion in one sentence.")
print(response)

# Model-specific inference via URI scheme
# Supports: openai:gpt-4o, ollama:llama3, compat:mixtral
detailed = ai("What are typed pipelines?", {model: "openai:gpt-4o-mini"})
print(detailed)

