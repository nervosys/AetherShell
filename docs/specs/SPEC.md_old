    Int,
    Float,
    Bool,
    Str,
    Array(Box<Type>),
    Func(Vec<Type>, Box<Type>),
    Var(u32), // type variable for inference
}

struct TypeEnv { /* map of identifiers to types */ }

fn unify(t1: &Type, t2: &Type) -> Result<(), String> {
   // classic HM unification algorithm
}
