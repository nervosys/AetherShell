# Syntax highlighting for .ish files on GitHub
# Map to JavaScript highlighting as the closest match for IronShell's syntax
# (lambdas, let bindings, string interpolation, curly-brace records)
*.ish linguist-language=JavaScript

# Linguist overrides
*.rs linguist-detectable=true
*.tsx linguist-detectable=true
*.ts linguist-detectable=true

# Archive fixtures: byte-exact, never line-ending converted
tests/fixtures/archives/* binary
tests/fixtures/sample.db binary
