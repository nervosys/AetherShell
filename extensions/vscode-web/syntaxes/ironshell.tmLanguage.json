{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "IronShell",
    "scopeName": "source.ironshell",
    "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#numbers" },
        { "include": "#keywords" },
        { "include": "#operators" },
        { "include": "#functions" },
        { "include": "#modules" },
        { "include": "#constants" }
    ],
    "repository": {
        "comments": {
            "patterns": [
                { "name": "comment.line.number-sign.ironshell", "match": "#.*$" },
                { "name": "comment.block.ironshell", "begin": "/\\*", "end": "\\*/" }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.ironshell",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        { "name": "constant.character.escape.ironshell", "match": "\\\\." },
                        { "name": "variable.other.interpolation.ironshell", "match": "\\$\\{[^}]+\\}" }
                    ]
                },
                { "name": "string.quoted.single.ironshell", "begin": "'", "end": "'" }
            ]
        },
        "numbers": {
            "patterns": [
                { "name": "constant.numeric.float.ironshell", "match": "\\b\\d+\\.\\d+\\b" },
                { "name": "constant.numeric.integer.ironshell", "match": "\\b\\d+\\b" }
            ]
        },
        "keywords": {
            "patterns": [
                { "name": "keyword.control.ironshell", "match": "\\b(if|else|match|for|while|return|break|continue|try|catch|fn|let|mut)\\b" },
                { "name": "keyword.other.ironshell", "match": "\\b(import|export|use|as|in|from|where|select|map|reduce|filter|each|agent|swarm)\\b" },
                { "name": "storage.type.ironshell", "match": "\\b(Int|Float|String|Bool|Array|Record|Lambda|Null|Table)\\b" }
            ]
        },
        "operators": {
            "patterns": [
                { "name": "keyword.operator.pipe.ironshell", "match": "\\|>" },
                { "name": "keyword.operator.arrow.ironshell", "match": "=>" },
                { "name": "keyword.operator.pipe.ironshell", "match": "\\|" },
                { "name": "keyword.operator.comparison.ironshell", "match": "(==|!=|<=|>=|<|>)" },
                { "name": "keyword.operator.logical.ironshell", "match": "(&&|\\|\\||!)" },
                { "name": "keyword.operator.arithmetic.ironshell", "match": "(\\+|-|\\*|/|%)" },
                { "name": "keyword.operator.assignment.ironshell", "match": "=" }
            ]
        },
        "functions": {
            "patterns": [
                { "name": "entity.name.function.ironshell", "match": "\\b([a-z_][a-z0-9_]*)\\s*(?=\\()" }
            ]
        },
        "modules": {
            "patterns": [
                { "name": "entity.name.namespace.ironshell", "match": "\\b(file|sys|proc|net|http|crypto|db|math|str|arr|json|platform|ai|agent|mcp|a2a|a2ui|nanda|rbac|audit|sso|nn|evo|rl|docker|k8s|helm|cargo|git|gh)\\b(?=\\.)" }
            ]
        },
        "constants": {
            "patterns": [
                { "name": "constant.language.ironshell", "match": "\\b(true|false|null)\\b" }
            ]
        }
    }
}
